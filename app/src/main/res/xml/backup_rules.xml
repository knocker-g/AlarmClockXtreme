<?xml version="1.0" encoding="utf-8"?>
<!--
  KNO-102: OS-managed backup/transfer rules for Android 8-11 (API 26-30).
  OS-managed backup and device-transfer are EXCLUDED to eliminate Android OS
  as an unvalidated migration authority. Canonical cross-device migration is
  owned exclusively by the explicit versioned KNO-74 Backup/Restore framework.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
